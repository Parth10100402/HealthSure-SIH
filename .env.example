# -----------------------------------------------------------------------------
# HEALTHSURE — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env locally. Never commit actual secret keys to git.
# -----------------------------------------------------------------------------

# Supabase / PostgreSQL Database Connection (Optional Backend Persistence)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Google Maps API Key (For Map Visualizations & Geocoding)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Gemini / LLM API Key (For Live AI Medical Analysis)
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# Application Configuration
VITE_APP_ENV=production
VITE_APP_TITLE=HealthSure Consumer Healthcare Platform
